{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist-electron",
    "rootDir": ".",
    "noEmit": false,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": false,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["electron/**/*.ts", "src/lib/types.ts"]
}

